.venv/
venv/
__pycache__/
*.py[cod]

# local data (uploads, chroma index, sqlite registry)
# `data/*` rather than `data/` so the .gitkeep negation below actually works
data/*
!data/.gitkeep

# eval outputs are committed on purpose - the README quotes ranges across
# these runs, so a reader can check the claim rather than trust it. Raw runs
# are a few hundred KB in total; re-running adds new files, it does not
# overwrite old ones.

.env
.freebuff/
.pytest_cache/
.ruff_cache/
.streamlit/secrets.toml
.DS_Store
