# Copy to .env to override. Every value here is also the default, so the
# project runs without a .env file at all as long as Ollama is up.

# Models - anything `ollama list` shows, plus any sentence-transformers id
RESEARCHMIND_CHAT_MODEL=qwen2.5:3b
RESEARCHMIND_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RESEARCHMIND_OLLAMA_HOST=http://localhost:11434

# Chunking. Sizes are characters. Re-run `python scripts/ingest.py ... --reset`
# after changing these or the index will mix old and new chunking.
RESEARCHMIND_CHUNK_SIZE=900
RESEARCHMIND_CHUNK_OVERLAP=160

# Retrieval
RESEARCHMIND_TOP_K=6
RESEARCHMIND_DENSE_CANDIDATES=20
RESEARCHMIND_SPARSE_CANDIDATES=20
RESEARCHMIND_RRF_K=60

# Agent
RESEARCHMIND_MAX_AGENT_STEPS=6
RESEARCHMIND_TEMPERATURE=0.1
